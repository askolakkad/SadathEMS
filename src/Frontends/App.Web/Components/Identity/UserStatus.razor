<AuthorizeView>
    <Authorized>
        <span class="me-2">Hello, @context.User.Identity?.Name</span>
        <a class="btn btn-sm btn-outline-secondary" href="logout">Logout</a>
    </Authorized>
    <NotAuthorized>
        <a class="btn btn-sm btn-primary" href="login">Login</a>
    </NotAuthorized>
</AuthorizeView>
